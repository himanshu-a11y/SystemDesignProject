  "bugs": {
    "url": "https://github.com/himanshu-a11y/SystemDesignProject/issues"
  },
  "homepage": "https://github.com/himanshu-a11y/SystemDesignProject#readme",
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
