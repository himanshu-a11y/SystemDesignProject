# Server port (optional, defaults to 3000)
PORT=3000

# PostgreSQL connection string
# Leave empty to fall back to the in-memory repository (useful for quick local dev/tests).
#
# Local Docker Compose Postgres:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/expenses
#
# Free Neon PostgreSQL (https://neon.tech):
# 1. Sign up at https://neon.tech and create a new project.
# 2. In the Neon Dashboard -> Connection Details, copy the Connection String.
# 3. Ensure it includes ?sslmode=require at the end, for example:
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
